{
  "version": 1,
  "author": "Robot Sensor Monitor",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-mpu6050", "id": "imu", "top": -120, "left": 160, "attrs": {} },
    { "type": "wokwi-led", "id": "led1", "top": 30, "left": 230, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 110, "left": 190, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-pushbutton", "id": "btn1", "top": 200, "left": 200, "attrs": { "color": "green" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "imu:VCC", "esp:3V3", "red", [] ],
    [ "imu:GND", "esp:GND.2", "black", [] ],
    [ "imu:SDA", "esp:21", "blue", [] ],
    [ "imu:SCL", "esp:22", "yellow", [] ],
    [ "esp:2", "r1:1", "green", [] ],
    [ "r1:2", "led1:A", "green", [] ],
    [ "led1:C", "esp:GND.1", "black", [] ],
    [ "btn1:1.l", "esp:4", "orange", [] ],
    [ "btn1:2.l", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
